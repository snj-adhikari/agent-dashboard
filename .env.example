# Port the dashboard listens on
MONITOR_PORT=5818

# MongoDB connection string used for settings and History logging
MONGO_URL=mongodb://127.0.0.1:27017

# Comma-separated repo scan roots. Optional override; normally set in the setup guide.
# WATCH_DIRS=

# Path to your Obsidian vault for the Vault nav tab. Optional override; normally set in the setup guide.
# VAULT_PATH=

# Database name. Optional; defaults to agent_monitor.
# MONGO_DB=

# Set to 1 to skip the hook poller (useful for test servers).
# DISABLE_HOOKS=
