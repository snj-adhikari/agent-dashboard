{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "agent-cuckoo",
  "version": "0.0.0",
  "identifier": "dev.nightwalker.agent-cuckoo.tauri",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "island",
        "title": "agent-cuckoo",
        "width": 720,
        "height": 320,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "desktop-mascot",
        "title": "agent-cuckoo mascot",
        "url": "desktop-mascot.html",
        "width": 120,
        "height": 120,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "visible": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Snj - nightwalker",
    "category": "DeveloperTool",
    "shortDescription": "See and steer every agent from one island",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
