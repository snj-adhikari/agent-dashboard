{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-branch-convention.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-push-gate.py\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-signature.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-no-claude-pr-attribution.sh\""
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-create-pr-gate.sh\""
          }
        ]
      },
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-comment-style-guard.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__.*|WebFetch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-prod-browse-guard.py\""
          }
        ]
      },
      {
        "matcher": "Bash|Read|Edit|Write|Grep|Glob|mcp__aws-mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-aws-guard.py\""
          }
        ]
      },
      {
        "matcher": "mcp__.*Atlassian.*__(editJiraIssue|addWorklogToJiraIssue|executeWrite)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-jira-timetracking-guard.sh\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-create-pr-mark.sh\""
          }
        ]
      },
      {
        "matcher": "mcp__.*Atlassian.*__(createJiraIssue|getJiraIssue|searchJiraIssuesUsingJql)",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/agent-jira-timetracking-guard.sh\""
          }
        ]
      }
    ]
  }
}
